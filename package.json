{
  "name": "graph-agent",
  "version": "0.1.0",
  "description": "Pi coding agent driven by mutable Camunda-8-flavour BPMN graphs",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "graph-agent": "dist/graph-agent.js"
  },
  "files": [
    "dist",
    "static",
    "workflows",
    "element_templates"
  ],
  "scripts": {
    "build": "npm run build:cli && npm run build:assets && npm run build:css",
    "build:cli": "node scripts/build-cli.mjs",
    "build:assets": "node scripts/build-assets.mjs",
    "build:css": "tailwindcss -i ./src/css/styles.css -o ./static/tailwind.css --minify",
    "lint:templates": "htmlhint src/studio/pages/*.html",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify:editor": "node scripts/verify-editor.mjs"
  },
  "dependencies": {
    "@bpmn-io/element-template-chooser": "^3.0.0",
    "@bpmn-io/element-template-icon-renderer": "^1.0.0",
    "@bpmn-io/element-templates-validator": "^2.26.0",
    "@bpmn-io/feel-editor": "^2.7.1",
    "@bpmn-io/form-js": "^1.10.0",
    "@bpmn-io/properties-panel": "^3.49.2",
    "@earendil-works/pi-agent-core": "1.0.0",
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "@resvg/resvg-js": "^2.6.2",
    "bpmn-elements": "^17.3.0",
    "bpmn-engine": "^25.0.1",
    "bpmn-js": "^18.24.0",
    "bpmn-js-bpmnlint": "^0.24.0",
    "bpmn-js-create-append-anything": "^2.0.0",
    "bpmn-js-element-templates": "^2.34.0",
    "bpmn-js-properties-panel": "^5.64.0",
    "bpmn-js-token-simulation": "^0.40.0",
    "bpmn-moddle": "^10.2.0",
    "bpmnlint": "^11.13.0",
    "diagram-js-minimap": "^5.4.1",
    "feelin": "^7.0.1",
    "jsdom": "^26.1.0",
    "moddle-context-serializer": "^6.0.2",
    "ws": "^8.18.0",
    "zeebe-bpmn-moddle": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/ws": "^8.5.13",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.28.2",
    "htmlhint": "^1.9.2",
    "playwright-core": "^1.62.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
