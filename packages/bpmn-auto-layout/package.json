{
  "name": "@graph-agent/bpmn-auto-layout",
  "version": "0.1.0",
  "private": true,
  "description": "Orthogonal BPMN layout and label DI generation",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "package.json"],
  "scripts": {
    "build": "npm run build:js && npm run build:types",
    "build:js": "esbuild src/index.ts --bundle --format=esm --platform=node --external:bpmn-moddle --external:zeebe-bpmn-moddle --outfile=dist/index.js --loader:.json=json",
    "build:types": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "bpmn-moddle": "^10.2.0",
    "zeebe-bpmn-moddle": "^2.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
